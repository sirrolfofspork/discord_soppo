# Copy to .env and fill in values. Never commit .env.



# Required: Discord bot token (Bot section in Discord Developer Portal)

DISCORD_BOT_TOKEN=your_bot_token_here



# LLM backend: ollama (local), lmstudio (local OpenAI-compatible), or openai (API)

# Allowed: ollama, lmstudio, openai

LLM_BACKEND=ollama



# --- Ollama (when LLM_BACKEND=ollama) ---

# Base URL (no trailing slash)

OLLAMA_URL=http://localhost:11434

# Must exist locally (`ollama list`). Install with: ollama pull <name>

OLLAMA_MODEL=qwen3.5:4b



# --- OpenAI (when LLM_BACKEND=openai) ---

# Required for openai backend; leave empty if using ollama only

OPENAI_API_KEY=

OPENAI_MODEL=gpt-5.4-mini



# --- LM Studio (when LLM_BACKEND=lmstudio) ---

# OpenAI-compatible local server base URL

LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Must match the loaded model name in LM Studio

LMSTUDIO_MODEL=<model-name>

# LM Studio's local API usually accepts any non-empty placeholder key

LMSTUDIO_API_KEY=not-needed



# Sampling (used for both backends where the API supports them)

OLLAMA_TEMPERATURE=0.9

OLLAMA_TOP_P=0.9

OLLAMA_MAX_TOKENS=160



# Comma-separated names/phrases that count as talking to the bot (case-insensitive, whole-word match)

# Example: BOT_NAME_ALIASES=SOPPO,Soppo,M4,SOPMOD,M4 SOPMOD II

BOT_NAME_ALIASES=



# Preferred for multi-server deployments: comma-separated exact Discord channel IDs.
# When set, these IDs take priority over DISCORD_CHANNEL_NAME.
# Example: DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789

DISCORD_ALLOWED_CHANNEL_IDS=


# Fallback when DISCORD_ALLOWED_CHANNEL_IDS is empty: only process messages in a channel with this name (case-insensitive)

DISCORD_CHANNEL_NAME=general



# Probability (0.0–1.0) of a spontaneous reply when not directly addressed

SPONTANEOUS_REPLY_CHANCE=0.10



# Seconds after any bot reply before spontaneous replies are allowed again

REPLY_COOLDOWN_SECONDS=30



# Rolling history: max messages to remember per channel (user + assistant turns)

MAX_CONTEXT_MESSAGES=20



# Rough cap on total character length of context sent to the LLM (safety valve)

MAX_PROMPT_CHARS=8000



# After the model replies: gently trim if longer than this (sentences/spaces, then ...)

DISCORD_REPLY_SOFT_LIMIT=500



# Max characters per Discord message when splitting long replies (must be <= 2000)

DISCORD_REPLY_HARD_LIMIT=1800



# Rare "returning user" LLM hint (no extra Discord message)

# Min wall-clock seconds since this user's last message in this channel (default 12 hours)

RETURNING_USER_THRESHOLD_SECONDS=43200

# Monotonic seconds before the same user can trigger the hint again (default 24 hours)

USER_GREETING_COOLDOWN_SECONDS=86400

# Monotonic seconds before ANY user can trigger the hint in this channel (default 4 hours)

CHANNEL_GREETING_COOLDOWN_SECONDS=14400

# Probability the hint is added when all other checks pass (0.0–1.0, default 0.20)

RETURNING_USER_GREETING_CHANCE=0.20



# Wall-clock seconds: after you address SOPPO, keep replying without re-mentioning (sliding window)

INFERRED_FOLLOWUP_WINDOW_SECONDS=180
