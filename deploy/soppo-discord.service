[Unit]
Description=SOPPO Discord Bot
Documentation=file:/home/erik-desimone/AI/agents/soppo_discord/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/erik-desimone/AI/agents/soppo_discord
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/erik-desimone/AI/agents/soppo_discord/.venv/bin/python /home/erik-desimone/AI/agents/soppo_discord/main.py
Restart=always
RestartSec=15s
KillSignal=SIGINT
TimeoutStopSec=20s

# Secrets stay in the repo-local .env file, which main.py loads with python-dotenv.
# Logs go to journald: journalctl --user -u soppo-discord.service -f

[Install]
WantedBy=default.target
